{# One add-on panel. Chip text is the same string as the panel title (beauty wording, not the old tech dictionary). #}
{% set oc_dock_items = [['stylist','مستشارة الجمال','Beauty advisor'],['voice','البحث الصوتي','Voice search'],['listen','اسمعي طريقة الاستخدام','Listen to how-to'],['tryon','حجم العبوة الحقيقي','True bottle size'],['recolour','اختاري الدرجة','Pick a shade'],['photocoach','نصائح الاستخدام والحفظ','Use & care tips'],['colorbook','دليل الدرجات','Shade guide'],['look','أكملي الروتين','Complete the routine'],['quiz','اختبار بشرتك واحتياجك','Skin & needs quiz'],['undertone','يناسب بشرتك؟','Right for your skin?'],['giftfinder','مكتشف الهدايا','Gift finder'],['presets','روتينات جاهزة','Ready routines']] %}
<section class="oc-dock container" data-testid="oc-dock" aria-label="{{ language.code == 'ar' ? 'الإضافات الذكية' : 'Smart add-ons' }}">
  <div class="oc-dock__inner">
    <button type="button" class="oc-dock__lead" data-oc-dock="open"><span class="oc-dock__star">✦</span> {{ language.code == 'ar' ? 'الإضافات الذكية' : 'Smart add-ons' }}</button>
    <div class="oc-dock__chips">
      {% for it in oc_dock_items %}{% if not (oc_off is defined and (it[0] ~ ',') in oc_off) %}
      <button type="button" class="oc-dock__chip" data-oc-dock="{{ it[0] }}" data-oc-name="{{ language.code == 'ar' ? it[1] : it[2] }}">{{ language.code == 'ar' ? it[1] : it[2] }}</button>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
<style>
.oc-dock{margin-top:1rem;margin-bottom:.5rem}
.oc-dock__inner{display:flex;align-items:center;gap:.8rem;padding:.7rem 1rem;border-radius:1.2rem;background:linear-gradient(135deg,rgba(217,183,121,.14),rgba(255,255,255,.03));border:1px solid rgba(217,183,121,.35);box-shadow:0 10px 40px rgba(0,0,0,.35);overflow:hidden}
.oc-dock__lead{flex:none;padding:.55rem 1.1rem;border-radius:99px;background:linear-gradient(135deg,#e8cf9a,#b8935a);color:#111;font-weight:800;white-space:nowrap}
.oc-dock__chips{display:flex;gap:.45rem;overflow-x:auto;scrollbar-width:none;flex:1}
.oc-dock__chips::-webkit-scrollbar{display:none}
.oc-dock__chip{flex:none;padding:.45rem .9rem;border-radius:99px;border:1px solid rgba(217,183,121,.35);background:rgba(255,255,255,.04);color:inherit;font-size:.85rem;white-space:nowrap;transition:.2s}
.oc-dock__chip:hover{background:#d9b779;color:#111}
.oc-ai__x{width:1.8rem;height:1.8rem;border-radius:50%;border:1px solid var(--oc-line,rgba(255,255,255,.2));color:inherit;flex:none}
.oc-ai__p{max-height:min(70vh,560px);overflow:auto;z-index:10000}
</style>
<script>
(function(){
  function panel(){ return document.querySelector('.oc-ai'); }
  function open(id){
    var tries = 0;
    (function go(){
      var ai = panel();
      if (!ai || !ai._ocOpen) { if (tries++ < 40) return setTimeout(go, 100); return; }
      ai.classList.add('is-open');
      if (id && id !== 'open') ai._ocOpen(id, ai.querySelector('[data-a="'+id+'"]'));
    })();
  }
  document.addEventListener('click', function(e){
    var t = e.target.closest && e.target.closest('[data-oc-dock]'); if (!t) return;
    var id = t.getAttribute('data-oc-dock'), ai = panel();
    if (id === 'open' && ai && ai.classList.contains('is-open')) { ai.classList.remove('is-open'); return; }
    open(id);
  });
  document.addEventListener('keydown', function(e){
    if (e.key !== 'Escape') return;
    var ai = panel(); if (ai && ai.classList.contains('is-open')) ai.classList.remove('is-open');
  });
})();
</script>
